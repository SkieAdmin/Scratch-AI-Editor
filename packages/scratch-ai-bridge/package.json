{
  "name": "@skieadmin/scratch-ai-bridge",
  "version": "15.1.1",
  "description": "Local MCP server and AI provider proxy that lets an external AI client drive the Scratch editor.",
  "keywords": [
    "scratch",
    "mcp",
    "model context protocol",
    "ai",
    "bridge",
    "websocket"
  ],
  "license": "AGPL-3.0-only",
  "author": "SkieAdmin (https://github.com/SkieAdmin)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "scratch-ai-bridge": "bin/scratch-ai-bridge.mjs"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "LICENSE",
    "README.md",
    "TRADEMARK",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "clean": "rimraf dist",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "start": "node bin/scratch-ai-bridge.mjs",
    "test": "npm run lint && vitest run --coverage"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.72",
    "prettier": "3.9.8",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "unplugin-dts": "1.1.0",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.11"
  }
}
